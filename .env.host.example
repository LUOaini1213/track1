# Host development: `npm run dev`, Codex CLI as a local process, no Docker.
# Copy to .env at the repository root. For the container path use .env.example,
# which targets Docker Compose and uses in-image absolute paths.

# Loopback only. Binding a wider interface requires APP_AUTH_TOKEN — see below.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# No token is required while the server is loopback-only. Set one (24+ random
# characters) if you change HOST, or startup will refuse to continue.
# APP_AUTH_TOKEN=

# A model that speaks the OpenAI-compatible Responses API. ARK_BASE_URL may
# point at Ark, DeepSeek, or any other compatible provider.
ARK_API_KEY=replace-with-your-model-api-key
ARK_MODEL=deepseek-chat
ARK_BASE_URL=https://api.deepseek.com/v1

# Repository-relative state, so a host run does not write to /app.
APP_DATA_DIR=.data
AGENT_WORKSPACE_ROOT=workspaces
CODEX_HOME=codex-home
RUNTIME_PROVIDER=local-process

# Windows only. npm installs codex, codex.cmd and codex.ps1 but no .exe, and the
# runner spawns without a shell, so point this at the package's .js entrypoint.
# Find the directory with `npm root -g`.
# CODEX_BIN=C:/Users/<you>/AppData/Roaming/npm/node_modules/@openai/codex/bin/codex.js

# Price of the model above, per million tokens. Leave unset and the Playground
# shows token counts with no dollar figure, which beats pricing a model you are
# not running. The values below are DeepSeek chat list prices.
COST_INPUT_USD_PER_MTOK=0.14
COST_OUTPUT_USD_PER_MTOK=0.28

# Mirrors OpenTelemetry's Opt-In rule for GenAI content. false withholds
# commands, error text and workspace paths from stored spans.
TRACE_CAPTURE_CONTENT=true
